{
  "name": "propflow",
  "version": "0.1.0",
  "private": true,
  "description": "PropFlow — public real-estate listings + private lead-to-site-visit CRM for a single brokerage.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run db:verify && npm run verify:demo",
    "db:seed": "node scripts/seed.mjs",
    "db:verify": "node scripts/verify-security.mjs",
    "verify:demo": "node --conditions=react-server scripts/verify-demo.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
