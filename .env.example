# ---------------------------------------------------------------------------
# PropFlow environment
# Copy to .env.local for development. Every value below is server-controlled;
# nothing here is ever read by the browser except the two NEXT_PUBLIC_* values,
# and the browser only ever receives the anon (publishable) key.
# ---------------------------------------------------------------------------

# Supabase project → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only. Project Settings → API Keys → service_role.
# Used exclusively inside server actions to call auth.admin.* and the
# submit_public_enquiry() RPC. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Slug of the single brokerage that serves the public site.
# The public enquiry RPC resolves the tenant from this value; the browser can
# never choose its own tenant.
PROPFLOW_TENANT_SLUG=northstar-demo

# Demo mode. 1 = run entirely on in-memory fictional fixtures, no Supabase
# project required. Mutations are simulated and reset when the server restarts.
#
# Leave this UNSET to run the demo out of the box: with no NEXT_PUBLIC_SUPABASE_URL
# the app falls back to fixtures automatically, so `git clone && npm install &&
# npm run dev` works with no setup. A production build with neither a project nor
# this flag refuses to start rather than quietly serving fictional data.
#
# Set it to 0 to turn demo mode off even when no project is configured, which is
# what you want if you would rather see the "NEXT_PUBLIC_SUPABASE_URL is not set"
# error than fictional listings. Set it to 1 to force demo mode even when a real
# project is configured. Do not enable it in production: demo mode has no
# password store, and see PROPFLOW_DEMO_SECRET below for what a production
# deployment would then require before anyone could sign in.
#
# PROPFLOW_DEMO_MODE=0

# Canonical origin, used for absolute URLs in metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Signs the demo-mode session cookie (HMAC-SHA256).
#
# Optional, and only relevant when PROPFLOW_DEMO_MODE=1. Outside a production
# build a committed development fallback is used, which is safe only because demo
# mode is then confined to a developer's own machine. In a production build this
# value is REQUIRED: with demo mode on and no secret configured, the app refuses
# to issue a session rather than falling back to the committed key. Use at least
# 32 characters of random text; never reuse the demo password.
#
# PROPFLOW_DEMO_SECRET=